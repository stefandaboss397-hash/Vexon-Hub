    }, parent)
    corner(ring, 99)
    TweenService:Create(ring, TweenInfo.new(duration or 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(scaleTo or 2.6, 0, scaleTo or 2.6, 0),
        BackgroundTransparency = 1,
    }):Play()
    task.delay(duration or 0.55, function() pcall(function() ring:Destroy() end) end)
end

local function rippleAt(parent, mouseX, mouseY, col, dur)
    if not parent then return end
    local pAbs, pSize = parent.AbsolutePosition, parent.AbsoluteSize
    if pSize.X <= 0 or pSize.Y <= 0 then return end
    local relX = math.clamp((mouseX - pAbs.X) / pSize.X, 0, 1)
    local relY = math.clamp((mouseY - pAbs.Y) / pSize.Y, 0, 1)
    local ripple = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(relX, 0, relY, 0),
        Size = UDim2.fromOffset(4, 4),
        BackgroundColor3 = col or C.accent,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0, ZIndex = 5,
    }, parent)
    corner(ripple, 999)
    local maxSize = math.max(pSize.X, pSize.Y) * 2
    TweenService:Create(ripple, TweenInfo.new(dur or 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(maxSize, maxSize),
        BackgroundTransparency = 1,
    }):Play()
    task.delay(dur or 0.55, function() pcall(function() ripple:Destroy() end) end)
end

local function confettiBurst(parent, col, count)
    count = count or 12
    if not parent then return end
    for i = 1, count do
        local sz = math.random(3, 6)
        local particle = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(math.random(30, 70) / 100, 0, 0.5, 0),
            Size = UDim2.fromOffset(sz, sz),
            BackgroundColor3 = col or C.on,
            BorderSizePixel = 0, ZIndex = 100,
        }, parent)
        corner(particle, sz / 2)
        local angle = math.random() * math.pi * 2
        local dist  = math.random(30, 70)
        local dx, dy = math.cos(angle) * dist, math.sin(angle) * dist
        local dur = 0.55 + math.random() * 0.25
        TweenService:Create(particle, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, dx, 0.5, dy),
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(1, 1),
            Rotation = math.random(-180, 180),
        }):Play()
        task.delay(dur + 0.05, function() pcall(function() particle:Destroy() end) end)
    end
end

local function flashFrame(frame, col, holdTime)
    if not frame then return end
    local origCol, origTrans = frame.BackgroundColor3, frame.BackgroundTransparency
    frame.BackgroundColor3 = col or C.accent
    frame.BackgroundTransparency = math.max(0, origTrans - 0.15)
    task.delay(holdTime or 0.14, function()
        pcall(function()
            tween(frame, 0.28, {BackgroundColor3 = origCol, BackgroundTransparency = origTrans})
        end)
    end)
end

local function createAurora(parent)
    local holder = new("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        ClipsDescendants = true, ZIndex = 0,
    }, parent)
    local colors = {C.purple, C.accent, Color3.fromRGB(255, 80, 200)}
    local orbs = {}
    for i = 1, 3 do
        local sz = 220 + i * 50
        local orb = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.fromOffset(sz, sz),
            BackgroundColor3 = colors[i],
            BackgroundTransparency = 0.9,
            BorderSizePixel = 0, ZIndex = 0,
        }, holder)
        corner(orb, sz / 2)
        orbs[#orbs + 1] = {
            frame = orb,
            speedX = 0.014 + i * 0.006,
            speedY = 0.011 + i * 0.005,
            phase  = i * 2.1,
            radiusX = 0.22 + i * 0.03,
            radiusY = 0.18 + i * 0.03,
        }
    end
    return orbs
end
local function updateAurora(orbs, t)
    for _, o in ipairs(orbs) do
        if o.frame.Parent then
            local x = 0.5 + math.sin(t * o.speedX + o.phase) * o.radiusX
            local y = 0.5 + math.cos(t * o.speedY + o.phase) * o.radiusY
            o.frame.Position = UDim2.new(x, 0, y, 0)
        end
    end
end

