-- Silent aim
local silentTarget, silentHook, lastFire = nil, nil, 0
local function installSilentHook()
    if silentHook ~= nil then return silentHook end
    silentHook = false
    if not (hookmetamethod and getnamecallmethod) then return false end
    local ok = pcall(function()
        local old
        local function hook(self, ...)
            local m = getnamecallmethod()
            if m == "Raycast" and S.silent and silentTarget and self == workspace and not (checkcaller and checkcaller()) then
                local args = {...}
                if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                    if args[2].Magnitude > 150 and (args[1] - camera.CFrame.Position).Magnitude < 12 then
                        args[2] = (silentTarget.Position - args[1]).Unit * args[2].Magnitude
                        return old(self, table.unpack(args, 1, select("#", ...)))
                    end
                end
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
    end)
    silentHook = ok; return ok
end
local function silentStep()
    if not S.silent then silentTarget = nil; return end
    silentTarget = findTarget(S.sVisible, S.sTeam, S.part, S.fovSize)
    if S.autoFire and silentTarget and tick() - lastFire > 0.12 then lastFire = tick(); clickScreen() end
end

-- Trigger bot
local lastTrigger = 0
local function triggerStep()
    if not S.trigger then return end
    if tick() - lastTrigger < math.max(S.fireDelay, 0.05) then return end
    local vp = camera.ViewportSize; local c = Vector2.new(vp.X/2, vp.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and not (S.tTeam and isTeammate(p)) then
            local char = p.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            if hum and hum.Health > 0 and hrp and head then
                local topV, onT = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
                local botV, onB = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                if onT and onB then
                    local h = math.abs(topV.Y - botV.Y); local w = h/2.2
                    local cx = (topV.X + botV.X) / 2
                    local yMin = math.min(topV.Y, botV.Y); local yMax = math.max(topV.Y, botV.Y)
                    if math.abs(c.X - cx) <= w/2 and c.Y >= yMin and c.Y <= yMax then
                        if not S.tVisible or partVisible(hrp) then lastTrigger = tick(); clickScreen(); return end
                    end
                end
            end
        end
    end
end

