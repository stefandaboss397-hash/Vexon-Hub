local visParams = RaycastParams.new()
visParams.FilterType = Enum.RaycastFilterType.Exclude
visParams.IgnoreWater = true
local function partVisible(part)
    local char = localPlayer.Character
    if not part or not part.Parent then return false end
    local filter = {part.Parent}; if char then filter[2] = char end
    visParams.FilterDescendantsInstances = filter
    local origin = camera.CFrame.Position
    return workspace:Raycast(origin, part.Position - origin, visParams) == nil
end
local function findTarget(vis, team, partName, fov)
    local vp = camera.ViewportSize; local c = Vector2.new(vp.X/2, vp.Y/2)
    local best, bestD = nil, fov
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and not (team and isTeammate(p)) then
            local char = p.Character; local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = char:FindFirstChild(partName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                if part then
                    local sp, on = camera:WorldToViewportPoint(part.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
                        if d <= bestD and (not vis or partVisible(part)) then best, bestD = part, d end
                    end
                end
            end
        end
    end
    return best
end
local function clickScreen()
    pcall(function()
