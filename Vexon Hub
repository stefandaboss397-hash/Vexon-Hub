-- ============ DISC ANIMAT (Vinyl) ============
local function createVinylDisc(parent, size, baseCol, accentCol, spinSpeed)
    local holder = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1, ZIndex = 0, Active = false,
    }, parent)

    local body = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = baseCol, BackgroundTransparency = 0.75,
        BorderSizePixel = 0, ZIndex = 0, Active = false,
    }, holder)
    corner(body, size / 2)
    local bs = addStroke(body, accentCol, 1.5); bs.Transparency = 0.4

    local spinner = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, ZIndex = 0, Active = false,
    }, holder)

    for i = 1, 5 do
        local gs = size * (i / 6) * 0.92
        local groove = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(gs, gs),
            BackgroundTransparency = 1, ZIndex = 0, Active = false,
        }, spinner)
        corner(groove, gs / 2)
        local gst = addStroke(groove, accentCol, 1)
        gst.Transparency = 0.65 + i * 0.06
    end

    local dotR = size * 0.42
    for i = 1, 12 do
        local ang = (i / 12) * math.pi * 2
        local dot = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, math.cos(ang) * dotR, 0.5, math.sin(ang) * dotR),
            Size = UDim2.fromOffset(3, 3),
            BackgroundColor3 = accentCol, BackgroundTransparency = 0.35,
            BorderSizePixel = 0, ZIndex = 0, Active = false,
        }, spinner)
        corner(dot, 2)
    end

    local chSize = size * 0.16
    local center = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(chSize, chSize),
        BackgroundColor3 = Color3.fromRGB(10, 10, 14),
        BorderSizePixel = 0, ZIndex = 0, Active = false,
    }, spinner)
    corner(center, chSize / 2)
    addStroke(center, accentCol, 1).Transparency = 0.4

    return holder, spinner, spinSpeed or 1
end

-- ============ PARTICULE FLOTANTE ============
local function createFloatingParticles(parent, count, col)
    local list = {}
    for i = 1, count do
        local sz = math.random(2, 4)
        local f = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            Size = UDim2.fromOffset(sz, sz),
            BackgroundColor3 = col, BackgroundTransparency = 0.5,
            BorderSizePixel = 0, ZIndex = 0, Active = false,
        }, parent)
        corner(f, sz / 2)
        list[#list + 1] = {
            frame = f,
            speed = math.random(10, 30) / 1000,
            wobble = math.random(15, 35) / 10,
            phase = math.random() * math.pi * 2,
        }
    end
    return list
end

local function updateParticles(parts, dt, t)
    for _, p in ipairs(parts) do
        local f = p.frame
        if f and f.Parent then
            local y = f.Position.Y.Scale - p.speed * dt * 60
            local x = f.Position.X.Scale + math.sin(t * p.wobble + p.phase) * 0.0008
            if y < -0.05 then y = 1.05; x = math.random() end
            f.Position = UDim2.new(x, 0, y, 0)
            f.BackgroundTransparency = 0.4 + math.abs(math.sin(t * 2 + p.phase)) * 0.35
        end
    end
end

