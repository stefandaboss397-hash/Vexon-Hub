-- ================ CONFIG MANAGER ================
local ConfigManager = {
    folder = CONFIG_FOLDER .. "/Configs",
    registry = { toggles = {}, sliders = {}, dropdowns = {} },
}
local function sanitizeName(n)
    if not n or n == "" then return nil end
    n = tostring(n):gsub("[^%w_%-%s%.]", ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%.%.", "_")
    if n == "" or n == "." then return nil end
    if #n > 48 then n = n:sub(1, 48) end
    return n
end
function ConfigManager:Register(kind, key, ref)
    if not self.registry[kind] then self.registry[kind] = {} end
    self.registry[kind][key] = ref
end
function ConfigManager:Collect()
    local data = { __version = 2, __savedAt = os.date("%Y-%m-%d %H:%M:%S") }
    for key, ref in pairs(self.registry.toggles) do
        local ok, v = pcall(function() return ref:GetState() end)
        if ok then data[key] = { t = "toggle", v = v } end
    end
    for key, ref in pairs(self.registry.sliders) do
        local ok, v = pcall(function() return ref:Get() end)
        if ok then data[key] = { t = "slider", v = v } end
    end
    for key, ref in pairs(self.registry.dropdowns) do
        local ok, v = pcall(function() return ref:Get() end)
        if ok then data[key] = { t = "dropdown", v = v } end
    end
    return data
end
function ConfigManager:Apply(data)
    local count = 0
    for key, entry in pairs(data) do
        if type(entry) == "table" and entry.t and entry.v ~= nil then
            if entry.t == "toggle" then
                local ref = self.registry.toggles[key]
                if ref then
                    if ref.SetSilent then ref:SetSilent(entry.v) else ref:Set(entry.v) end
                    count = count + 1
                end
            elseif entry.t == "slider" then
                local ref = self.registry.sliders[key]
                if ref then ref:Set(entry.v); count = count + 1 end
            elseif entry.t == "dropdown" then
                local ref = self.registry.dropdowns[key]
                if ref then ref:Set(entry.v); count = count + 1 end
            end
        end
    end
    return count
end
function ConfigManager:Save(name)
    name = sanitizeName(name); if not name then return false, "invalid name" end
    local ok, err = pcall(function()
        if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
        if not isfolder(self.folder) then makefolder(self.folder) end
        writefile(self.folder .. "/" .. name .. ".json", HttpService:JSONEncode(self:Collect()))
    end)
    if ok then return true, name end
    return false, tostring(err)
end
function ConfigManager:Load(name)
    name = sanitizeName(name); if not name then return false, "invalid name" end
    local path = self.folder .. "/" .. name .. ".json"
    if not isfile(path) then return false, "not found" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" then return false, "parse error" end
    return true, self:Apply(data)
end
function ConfigManager:Delete(name)
    name = sanitizeName(name); if not name then return false, "invalid name" end
    local path = self.folder .. "/" .. name .. ".json"
    if not isfile(path) then return false, "not found" end
    pcall(delfile, path)
    return true, name
end
function ConfigManager:List()
    local list = {}
    if not isfolder(self.folder) then return list end
    local ok, files = pcall(function() return listfiles(self.folder) end)
    if not ok or not files then return list end
    for _, f in ipairs(files) do
        local name = f:match("([^/\\]+)%.json$")
        if name then list[#list + 1] = name end
    end
    table.sort(list)
    return list
end
function ConfigManager:Exists(name)
    name = sanitizeName(name); if not name then return false end
    return isfile(self.folder .. "/" .. name .. ".json")
end

