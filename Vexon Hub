-- ================ STEALTH MODULE ================
local Stealth = {
    enabled = true, humanizeAim = true, randomPauses = true,
    randomizedDelays = true, behaviorNoise = true, antiLog = true, antiAfkPlus = true,
    pauseChance = 0.03, pauseMinMs = 25, pauseMaxMs = 90,
    jitterStuds = 0.018, smoothVariance = 0.12, overshootChance = 0.14,
    pauseUntil = 0, protectionLevel = 0, _logHooked = false,
}

local function humanizedAim(goalCF, baseSmoothing)
    if not Stealth.humanizeAim then
        camera.CFrame = camera.CFrame:Lerp(goalCF, 1 / math.max(baseSmoothing, 1))
        return
    end
    if Stealth.randomPauses then
        local now = tick()
        if now < Stealth.pauseUntil then return end
        if math.random() < Stealth.pauseChance then
            Stealth.pauseUntil = now + math.random(Stealth.pauseMinMs, Stealth.pauseMaxMs) / 1000
            return
        end
    end
    local variance = 1 + (math.random() - 0.5) * 2 * Stealth.smoothVariance
    local smooth   = math.max(1, baseSmoothing * variance)
    local j = Stealth.jitterStuds
    local jitteredGoal = goalCF * CFrame.new(
        (math.random() - 0.5) * j,
        (math.random() - 0.5) * j,
        (math.random() - 0.5) * j * 0.4
    )
    local step = 1 / smooth
    if math.random() < Stealth.overshootChance then
        step = step * (1 + math.random(2, 6) / 100)
    end
    camera.CFrame = camera.CFrame:Lerp(jitteredGoal, step)
end

function Stealth:installAntiLog()
    if not self.antiLog or self._logHooked then return end
    self._logHooked = true
    pcall(function()
        self._origPrint = print
        self._origWarn  = warn
        local keywords = {"Vexon", "Aimbot", "Silent", "Trigger Bot", "Skin Changer"}
        local function filt(v)
            if type(v) ~= "string" then return false end
            for _, k in ipairs(keywords) do
                if string.find(v, k, 1, true) then return true end
            end
            return false
        end
        print = function(...)
            local a = {...}; for i = 1, #a do if filt(a[i]) then return end end
            self._origPrint(...)
        end
        warn = function(...)
            local a = {...}; for i = 1, #a do if filt(a[i]) then return end end
            self._origWarn(...)
        end
    end)
end
function Stealth:restoreAntiLog()
    if self._origPrint then print = self._origPrint; self._origPrint = nil end
    if self._origWarn  then warn  = self._origWarn;  self._origWarn  = nil  end
    self._logHooked = false
end
function Stealth:installAntiAfkPlus()
    if not self.antiAfkPlus then return end
    task.spawn(function()
        while isRunning do
            task.wait(math.random(25, 45))
            pcall(function()
                local vu = game:GetService("VirtualUser")
                vu:CaptureController()
                vu:ClickButton2(Vector2.new(math.random(0, 50), math.random(0, 50)))
                local hum = getHum()
                if hum and math.random() < 0.4 then
                    local r = hum.MoveDirection
                    if r.Magnitude < 0.1 then
                        hum:Move(Vector3.new(math.random(-1,1)*0.1, 0, math.random(-1,1)*0.1), false)
                    end
                end
            end)
        end
    end)
end
function Stealth:installBehaviorNoise()
    if not self.behaviorNoise then return end
    task.spawn(function()
        while isRunning do
            task.wait(math.random(8, 20))
            if S.aimbot or S.silent then
                Stealth.pauseUntil = tick() + math.random(80, 220) / 1000
            end
        end
    end)
end
function Stealth:updateLevel()
    local score = 0
    if self.humanizeAim      then score = score + 1 end
    if self.randomPauses     then score = score + 1 end
    if self.randomizedDelays then score = score + 1 end
    if self.behaviorNoise    then score = score + 1 end
    if self.antiLog          then score = score + 1 end
    if self.antiAfkPlus      then score = score + 1 end
    self.protectionLevel = math.floor((score / 6) * 100)
end

