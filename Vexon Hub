-- Helper
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(p, r) return new("UICorner", {CornerRadius = UDim.new(0, r)}, p) end
local function addStroke(p, c, t) return new("UIStroke", {Color = c or C.stroke, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p) end
local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end
local function tween(o, d, p, s) pcall(function() TweenService:Create(o, TweenInfo.new(d, s or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p):Play() end) end

local function atan2(y, x)
    if x > 0 then return math.atan(y / x)
    elseif x < 0 then return math.atan(y / x) + ((y >= 0) and math.pi or -math.pi) end
    return (y >= 0) and (math.pi / 2) or (-math.pi / 2)
end
local function drawLine(p, x1, y1, x2, y2, th, col)
    local dx, dy = x2 - x1, y2 - y1
    local len = math.sqrt(dx * dx + dy * dy)
    return new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
        Size = UDim2.fromOffset(len + 0.6, th),
        BackgroundColor3 = col, BorderSizePixel = 0,
        Rotation = math.deg(atan2(dy, dx)),
    }, p)
end
local function drawPoly(p, pts, th, col) for i = 1, #pts - 1 do drawLine(p, pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], th, col) end end
local function drawBolt(p, col) drawPoly(p, {{10,1},{3,10.5},{8.5,10.5},{7,17},{15,7},{9.5,7},{10,1}}, 1.5, col) end
local function drawX(p, col, size)
    local h = size / 2
    drawLine(p, -h, -h, h, h, 2, col).Position = UDim2.new(0.5, 0, 0.5, 0)
    drawLine(p, -h, h, h, -h, 2, col).Position = UDim2.new(0.5, 0, 0.5, 0)
end
local function drawCheck(p, col) drawPoly(p, {{4.5,9.5},{7.8,12.8},{13.5,6}}, 2, col) end
local function drawUpDown(p, col)
    local box = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(12, 16), BackgroundTransparency = 1}, p)
    drawPoly(box, {{2.5,6},{6,2.5},{9.5,6}}, 1.5, col); drawPoly(box, {{2.5,10},{6,13.5},{9.5,10}}, 1.5, col)
    return box
end
local function drawPointer(p, col)
    local box = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(14, 16), BackgroundTransparency = 1}, p)
    drawPoly(box, {{2,1.5},{2,11.5},{4.8,8.8},{8.8,8.8},{2,1.5}}, 1.5, col)
    return box
end
local function makeTabIcon(parent, kind)
    local box = new("Frame", {Position = UDim2.fromOffset(10, 9), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1}, parent)
    local strokes, fills = {}, {}
    local function ring(x, y, w, h)
        local f = new("Frame", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1}, box)
        corner(f, 99); strokes[#strokes + 1] = addStroke(f, C.dim, 1.5)
    end
    local function dot(x, y, s)
        local f = new("Frame", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(s, s), BackgroundColor3 = C.dim, BorderSizePixel = 0}, box)
        corner(f, 99); fills[#fills + 1] = f
    end
    if kind == "aim" then ring(0,0,14,14); dot(5.5,5.5,3)
    elseif kind == "silent" then ring(0,0,14,14); ring(4,4,6,6)
    elseif kind == "eye" then ring(0,3,14,8); dot(5,5,4)
    elseif kind == "player" then
        ring(4,0,6,6)
        local body = new("Frame", {Position = UDim2.fromOffset(1,8), Size = UDim2.fromOffset(12,6), BackgroundTransparency = 1}, box)
        corner(body, 4); strokes[#strokes + 1] = addStroke(body, C.dim, 1.5)
    elseif kind == "trigger" then ring(0,0,14,14); ring(3.5,3.5,7,7); dot(6,6,2)
    elseif kind == "skin" then ring(2,2,10,10); dot(4,4,2); dot(8,8,2)
    elseif kind == "settings" then ring(2,2,10,10); dot(4,4,2); dot(8,8,2)
    elseif kind == "social" then ring(0,0,14,14); drawPoly(box, {{4,7},{7,11},{10,4}}, 1.5, C.dim)
    else ring(0,0,14,14); dot(3,4,2.5); dot(8,3.5,2.5); dot(6,8,2.5) end
    return function(col)
        for _, s in ipairs(strokes) do s.Color = col end
        for _, f in ipairs(fills) do f.BackgroundColor3 = col end
    end
end

