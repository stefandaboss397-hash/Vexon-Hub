    if o.dist then o.dist.Visible = false end
end
local function espStep()
    local wantDraw = S.espBox or S.espSkeleton or S.espLines or S.espName or S.espDist
    local wantHl = S.espOutline or S.espChams
    if not wantDraw and not wantHl then
        if espActive then clearEsp(); espActive = false end
        return
    end
    espActive = true
    local camCF = camera.CFrame; local vp = camera.ViewportSize
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            local char = p.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hum or hum.Health <= 0 or not hrp then
                removePlayerEsp(p)
            else
                local vis = partVisible(hrp); local mate = isTeammate(p)
                local colName = mate and (vis and S.colVisTeam or S.colInvTeam) or (vis and S.colVisEnemy or S.colInvEnemy)
                local color = colorOf(colName)
                local dist = (camCF.Position - hrp.Position).Magnitude
                local toT = hrp.Position - camCF.Position
                local inFov = math.deg(math.acos(math.clamp(camCF.LookVector:Dot(toT.Unit), -1, 1))) <= S.espMaxFov / 2
                if not inFov then
                    if espObjs[p] then hideObjs(espObjs[p]) end
                    if espHl[p] then pcall(function() espHl[p]:Destroy() end); espHl[p] = nil end
                else
                    if wantHl then
                        local hl = espHl[p]
                        if not hl or hl.Parent ~= char then
                            if hl then pcall(function() hl:Destroy() end) end
                            hl = Instance.new("Highlight")
                            hl.Adornee = char; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent = char
                            espHl[p] = hl
                        end
                        hl.FillColor = color; hl.OutlineColor = color
                        hl.FillTransparency = S.espChams and 0.5 or 1
                        hl.OutlineTransparency = S.espOutline and 0 or 1
                    elseif espHl[p] then pcall(function() espHl[p]:Destroy() end); espHl[p] = nil end

                    if wantDraw and drawingOk then
                        if not espObjs[p] then pcall(function() espObjs[p] = newEspObjs() end) end
                        local o = espObjs[p]
                        if o then
                            local hv, onScreen = camera:WorldToViewportPoint(hrp.Position)
                            if onScreen then
                                if S.espBox then
                                    local cf = hrp.CFrame; local hx, hy, hz = 1.5, 3, 1
                                    local corners = {
                                        cf * CFrame.new(-hx, hy, -hz), cf * CFrame.new(hx, hy, -hz),
                                        cf * CFrame.new(hx, hy, hz),  cf * CFrame.new(-hx, hy, hz),
                                        cf * CFrame.new(-hx, -hy, -hz), cf * CFrame.new(hx, -hy, -hz),
                                        cf * CFrame.new(hx, -hy, hz),  cf * CFrame.new(-hx, -hy, hz)
                                    }
                                    local p2d = {}; local allOn = true
                                    for i, c3 in ipairs(corners) do
                                        local sp, vis2 = camera:WorldToViewportPoint(c3.Position)
                                        if not vis2 then allOn = false end
                                        p2d[i] = Vector2.new(sp.X, sp.Y)
                                    end
                                    for idx, e in ipairs(BOX_EDGES) do
                                        local l = o.box[idx]
                                        if allOn then l.From = p2d[e[1]]; l.To = p2d[e[2]]; l.Color = color; l.Visible = true
                                        else l.Visible = false end
                                    end
                                else
                                    for _, l in ipairs(o.box) do l.Visible = false end
                                end
                                if S.espSkeleton then
                                    local bones = char:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
                                    for idx = 1, 14 do
                                        local l = o.skel[idx]; local pr = bones[idx]; local shown = false
                                        if pr then
                                            local a, b = char:FindFirstChild(pr[1]), char:FindFirstChild(pr[2])
                                            if a and b then
                                                local pa, oa = camera:WorldToViewportPoint(a.Position)
                                                local pb, ob = camera:WorldToViewportPoint(b.Position)
                                                if oa and ob then
                                                    l.From = Vector2.new(pa.X, pa.Y)
                                                    l.To = Vector2.new(pb.X, pb.Y)
                                                    l.Color = color; l.Visible = true; shown = true
                                                end
                                            end
                                        end
                                        if not shown then l.Visible = false end
                                    end
                                else
                                    for _, l in ipairs(o.skel) do l.Visible = false end
                                end
                                if S.espLines then
                                    o.tracer.From = Vector2.new(vp.X/2, vp.Y)
                                    o.tracer.To = Vector2.new(hv.X, hv.Y)
                                    o.tracer.Color = color; o.tracer.Visible = true
                                else o.tracer.Visible = false end
                                if o.name and o.dist then
                                    o.name.Position = Vector2.new(hv.X, hv.Y - 40)
                                    o.name.Text = p.Name; o.name.Color = color; o.name.Visible = S.espName
                                    o.dist.Position = Vector2.new(hv.X, hv.Y - 25)
                                    o.dist.Text = math.floor(dist) .. "m"; o.dist.Color = color; o.dist.Visible = S.espDist
                                end
                            else hideObjs(o) end
                        end
                    else
                        if espObjs[p] then hideObjs(espObjs[p]) end
                    end
                end
            end
        end
    end
end
