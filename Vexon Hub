-- ================ HELPERS ================
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(p, r) return new("UICorner", {CornerRadius = UDim.new(0, r)}, p) end
local function addStroke(p, c, t)
    return new("UIStroke", {Color = c or C.stroke, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p)
end
local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function isMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end
local function tween(o, d, p, s)
    pcall(function()
        TweenService:Create(o, TweenInfo.new(d, s or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p):Play()
    end)
end
local function atan2(y, x)
    if x > 0 then return math.atan(y / x)
    elseif x < 0 then return math.atan(y / x) + ((y >= 0) and math.pi or -math.pi) end
    return (y >= 0) and (math.pi / 2) or (-math.pi / 2)
end

-- ================ DRAWING ================
local function drawLine(p, x1, y1, x2, y2, th, col)
    local dx, dy = x2 - x1, y2 - y1
    local len = math.sqrt(dx * dx + dy * dy)
    return new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
        Size = UDim2.fromOffset(len + 0.6, th),
        BackgroundColor3 = col, BorderSizePixel = 0,
        Rotation = math.deg(atan2(dy, dx)),
    }, p)
end
local function drawPoly(p, pts, th, col)
    for i = 1, #pts - 1 do
        drawLine(p, pts[i][1], pts[i][2], pts[i+1][1], pts[i+1][2], th, col)
    end
end
local function drawBolt(p, col)
    drawPoly(p, {{10,1},{3,10.5},{8.5,10.5},{7,17},{15,7},{9.5,7},{10,1}}, 1.5, col)
end
local function drawX(p, col, size)
    local h = size / 2
    local l1 = drawLine(p, -h, -h, h, h, 2, col); l1.Position = UDim2.new(0.5, 0, 0.5, 0)
    local l2 = drawLine(p, -h, h, h, -h, 2, col); l2.Position = UDim2.new(0.5, 0, 0.5, 0)
end
local function drawCheck(p, col)
    drawPoly(p, {{4.5,9.5},{7.8,12.8},{13.5,6}}, 2, col)
end
local function drawUpDown(p, col)
    local box = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(12, 16), BackgroundTransparency = 1}, p)
    drawPoly(box, {{2.5,6},{6,2.5},{9.5,6}}, 1.5, col)
    drawPoly(box, {{2.5,10},{6,13.5},{9.5,10}}, 1.5, col)
