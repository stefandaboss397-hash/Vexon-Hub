-- Movement
local flyBV = nil
local function stopFly()
    if flyBV then pcall(function() flyBV:Destroy() end); flyBV = nil end
    local hum = getHum(); if hum then pcall(function() hum.PlatformStand = false end) end
end
local function flyStep()
    if not S.fly then if flyBV then stopFly() end; return end
    local root = getRoot(); local hum = getHum(); if not root or not hum then return end
    if not flyBV or flyBV.Parent ~= root then
        if flyBV then pcall(function() flyBV:Destroy() end) end
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9); flyBV.Velocity = Vector3.new(0,0,0); flyBV.Parent = root
    end
    hum.PlatformStand = true
    local cf = camera.CFrame; local look = cf.LookVector; local right = cf.RightVector; local md = hum.MoveDirection; local vel = Vector3.new(0,0,0)
    if md.Magnitude > 0 then
        local fL = Vector3.new(look.X, 0, look.Z); local fR = Vector3.new(right.X, 0, right.Z)
        if fL.Magnitude > 0 and fR.Magnitude > 0 then
            local f = md:Dot(fL.Unit); local r = md:Dot(fR.Unit)
            vel = (look * f + right * r) * S.flySpeed
        end
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, S.flySpeed, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vel = vel - Vector3.new(0, S.flySpeed, 0) end
    flyBV.Velocity = vel
end
local function noclipStep()
    if not S.noclip then return end
    local char = getChar(); if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
    end
end
local function bhopStep()
    if not S.bhop then return end
    local hum = getHum(); if not hum then return end
    if hum.MoveDirection.Magnitude > 0 and hum.FloorMaterial ~= Enum.Material.Air then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end
local function speedStep()
    local hum = getHum(); if not hum then return end
    if S.walk then hum.WalkSpeed = S.walkValue end
    if S.jump then hum.UseJumpPower = true; hum.JumpPower = S.jumpValue end
end
local function resetWalk() local h = getHum(); if h then pcall(function() h.WalkSpeed = 16 end) end end
local function resetJump() local h = getHum(); if h then pcall(function() h.UseJumpPower = true; h.JumpPower = 50 end) end end

-- Skin changer
local SKINS = {
    ["Phoenix Rifle"] = {mat = "Neon", colors = {Color3.fromRGB(235,40,30), Color3.fromRGB(255,190,40)}},
    ["Frost"] = {mat = "Ice", colors = {Color3.fromRGB(120,200,255), Color3.fromRGB(225,245,255)}},
    ["Toxic"] = {mat = "Neon", colors = {Color3.fromRGB(80,255,60), Color3.fromRGB(30,120,30)}},
    ["Void"] = {mat = "ForceField", colors = {Color3.fromRGB(150,70,255), Color3.fromRGB(40,10,90)}},
    ["Gold"] = {mat = "Metal", colors = {Color3.fromRGB(255,200,50), Color3.fromRGB(200,140,20)}},
    ["Rainbow"] = {mat = "Neon", rainbow = true},
}
local SKIN_NAMES = {"Phoenix Rifle","Frost","Toxic","Void","Gold","Rainbow"}
local GUN_NAMES = {"All Guns","Assault Rifle","Handgun","Shotgun","Sniper","Energy Rifle","Exogun","Burst Rifle","Revolver","Katana","Chainsaw","Fists"}
local skinActive, skinOrig, skinHue = nil, {}, 0
local function compact(s) return string.lower((string.gsub(s, "%s", ""))) end
local function gunMatches(m, gun) if gun == "All Guns" then return true end return string.find(compact(m.Name), compact(gun), 1, true) ~= nil end
local function resetSkins()
    skinActive = nil
    local parts = {}; for p in pairs(skinOrig) do parts[#parts+1] = p end
    for _, p in ipairs(parts) do
        local o = skinOrig[p]
        pcall(function() p.Material = o.Material; p.Color = o.Color end)
        skinOrig[p] = nil
    end
end
local function skinStep(dt)
    if not skinActive then return end
    local def = SKINS[skinActive.skin]; if not def then return end
    skinHue = skinHue + dt * 0.3
    local ok, mat = pcall(function() return Enum.Material[def.mat] end)
    if not ok or not mat then return end
    for _, m in ipairs(camera:GetChildren()) do
        if m:IsA("Model") and not m:FindFirstChildOfClass("Humanoid") and gunMatches(m, skinActive.gun) then
            local idx = 0
            for _, part in ipairs(m:GetDescendants()) do
                if part:IsA("BasePart") and part.Transparency < 1 then
                    if not skinOrig[part] then skinOrig[part] = {Material = part.Material, Color = part.Color} end
                    idx = idx + 1; part.Material = mat
                    if def.rainbow then part.Color = Color3.fromHSV((skinHue + idx * 0.04) % 1, 1, 1)
                    else part.Color = def.colors[(idx % #def.colors) + 1] end
                end
            end
        end
    end
end

